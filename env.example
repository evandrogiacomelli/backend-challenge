# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=change-me

# AWS / LocalStack
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566

# Outbox: eventos financeiros publicados
SQS_QUEUE_URL=

# Inbox: transacoes financeiras recebidas
SQS_WAGER_QUEUE_URL=

# Dead-letter queue das transacoes recebidas
SQS_WAGER_DLQ_URL=

# Opcional: somente se utilizado por outro componente
SQS_DLQ_URL=

# Workers
OUTBOX_WORKER_ENABLED=false
SQS_WAGER_WORKER_ENABLED=false
PENDING_REFERENCE_WORKER_ENABLED=false

# Observabilidade
METRICS_TOKEN=
