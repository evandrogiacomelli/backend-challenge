
# ==========================================
# PostgreSQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering

# ==========================================
# AWS / LocalStack
# ==========================================
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566

# ==========================================
# SQS - Transactional Outbox
# Eventos financeiros publicados
# ==========================================
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# ==========================================
# SQS - Transactional Inbox
# Transacoes financeiras recebidas
# ==========================================
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wagers.fifo

# ==========================================
# SQS - Dead Letter Queue
# Mensagens que excederam as tentativas
# ==========================================
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wagers-dlq.fifo

# Opcional: apenas para componentes que usam
# uma DLQ generica
SQS_DLQ_URL=

# ==========================================
# Background Workers
# ==========================================
OUTBOX_WORKER_ENABLED=true
SQS_WAGER_WORKER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true

# ==========================================
# Observabilidade
# ==========================================
METRICS_TOKEN=local-dev-metrics-token
